# Supabase — get these from your project dashboard at app.supabase.com
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: exchange rate API key (e.g. exchangerate.host or open.er-api.com)
# Used for a periodic background job to refresh exchange_rates table
EXCHANGE_RATE_API_KEY=your-api-key
